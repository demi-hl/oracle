<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Electron needs JIT and unsigned executable memory for V8, and the hardened
    runtime denies both by default. Notarization fails without these.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!--
    The app spawns the bundled oracle CLI and a node server from Resources.
    Library validation would refuse to load those unsigned-by-Apple binaries.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Loopback HTTP between the shell, the data plane, and the Next server. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
